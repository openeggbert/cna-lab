<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net8.0;net9.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <RootNamespace>CNA.VB.Template</RootNamespace>
    <AssemblyName>HelloGame</AssemblyName>
    
    <!-- Engine Selection: CNA (default), MonoGame, FNA, Kni -->
    <Engine Condition="'$(Engine)' == ''">CNA</Engine>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Engine)' == 'CNA'">
    <DefineConstants>ENGINE_CNA</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Engine)' == 'MonoGame'">
    <DefineConstants>ENGINE_MONOGAME</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Engine)' == 'FNA'">
    <DefineConstants>ENGINE_FNA</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Engine)' == 'Kni'">
    <DefineConstants>ENGINE_KNI</DefineConstants>
  </PropertyGroup>

  <ItemGroup Condition="'$(Engine)' == 'CNA'">
    <ProjectReference Include="../../cna-vbnet/CNA.VB.Framework.vbproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(Engine)' == 'MonoGame'">
    <PackageReference Include="MonoGame.Framework.DesktopGL" Version="3.8.*" />
    <PackageReference Include="MonoGame.Content.Builder.Task" Version="3.8.*" />
  </ItemGroup>

  <ItemGroup Condition="'$(Engine)' == 'Kni'">
    <PackageReference Include="nkast.Xna.Framework" Version="3.9.*" />
    <PackageReference Include="nkast.Xna.Framework.Content.Pipeline.Builder" Version="3.9.*" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Content\**\*.*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
</Project>
